<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the single-file Yata.exe, before it goes into the installer.
     Copy of what is set in the SignPath project (slug "app"); keep both the same. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <pe-file path="Yata.exe" product-name="Yata" product-version="${version}">
    <authenticode-sign />
  </pe-file>
</artifact-configuration>
