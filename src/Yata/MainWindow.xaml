<Window x:Class="Yata.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:y="clr-namespace:Yata"
        xmlns:views="clr-namespace:Yata.Views"
        Title="Yata"
        Width="300" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True">
    <Grid>
        <!-- Everything outside NotchHost is fully transparent, so clicks pass through to the desktop.
             The window is resized in code (FitWindow) to the notch plus room for shadow and overshoot. -->

        <!-- Bubble: a second, small notch beside the first for what doesn't fit in it (another program's
             activity, the next meeting while music plays). Outside NotchHost, so hovering it doesn't open
             the notch; drawn first, so it slides out from under it. Placed in code (ApplyBubbleFrame).
             A small pill: where it comes from on the left (the program's icon, an agent's mark), how
             it's going on the right (the ring, the minutes, done or failed). Each sits in the middle of
             its round end. -->
        <Grid x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed"
              MouseEnter="OnBubbleMouseEnter" MouseLeave="OnBubbleMouseLeave" MouseLeftButtonUp="OnBubbleClick">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BubbleShift"/>
            </Grid.RenderTransform>
            <views:SoftShadow x:Name="BubbleShadow" HorizontalAlignment="Center" VerticalAlignment="Top"
                              BlurRadius="20" Depth="4" ShadowOpacity="0.4" Width="54" Height="32"/>
            <Path x:Name="BubbleShape" Fill="{DynamicResource NotchBrush}"/>
            <Grid x:Name="BubbleContent" Width="54" Height="22" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <views:IconView x:Name="BubbleIcon" Size="13" Margin="9.5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Grid Width="22" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right">
                    <Ellipse x:Name="BubbleTrack" Stroke="{DynamicResource TrackBrush}" StrokeThickness="2"/>
                    <Path x:Name="BubbleArc" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <!-- Done, failed or needs you -->
                    <TextBlock x:Name="BubbleGlyph" FontFamily="{StaticResource IconFont}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- Minutes to the next meeting, or left in a focus session -->
                    <TextBlock x:Name="BubbleLabel" FontSize="10" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- Running, with no progress to show -->
                    <Ellipse x:Name="BubbleDot" Width="5" Height="5" Fill="{DynamicResource TextSecondary}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Activities panel: the bubble grown up. While the notch is open, every activity is listed in a
             second notch beside it, so the open notch keeps its size. Outside NotchHost like the bubble;
             hovering it keeps the notch open. Placed and sized in code (ApplyActivityPanelFrame). -->
        <Grid x:Name="ActivityPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0"
              Visibility="Collapsed" MouseEnter="OnActivityPanelMouseEnter" MouseLeave="OnActivityPanelMouseLeave">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ActivityPanelShift"/>
            </Grid.RenderTransform>
            <views:SoftShadow x:Name="ActivityPanelShadow" HorizontalAlignment="Center" VerticalAlignment="Top"
                              BlurRadius="20" Depth="4" ShadowOpacity="0.4"/>
            <Path x:Name="ActivityPanelShape" Fill="{DynamicResource NotchBrush}"/>
            <StackPanel x:Name="ActivityStrip" Margin="14,8,10,8" VerticalAlignment="Top"/>
        </Grid>

        <Grid x:Name="NotchHost" HorizontalAlignment="Center" VerticalAlignment="Top"
              MouseEnter="OnNotchMouseEnter" MouseLeave="OnNotchMouseLeave"
              MouseLeftButtonUp="OnNotchClick"
              AllowDrop="True" DragEnter="OnNotchDragOver" DragOver="OnNotchDragOver"
              DragLeave="OnNotchDragLeave" Drop="OnNotchDrop">

            <views:SoftShadow x:Name="NotchShadow" HorizontalAlignment="Center" VerticalAlignment="Top"
                              BlurRadius="28" Depth="6" ShadowOpacity="0.45"/>
            <Path x:Name="NotchShape" Fill="{DynamicResource NotchBrush}"/>

            <Grid x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True">

                <!-- Compact: clock when idle, art + title + equalizer while media is active -->
                <Grid x:Name="CompactView" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="5"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <views:MarqueeText x:Name="CompactMarquee" Grid.Column="1" Margin="8,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactText"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Typography.NumeralAlignment="Tabular">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CompactTextShift"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </views:MarqueeText>

                    <StackPanel x:Name="CompactTimer" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="CompactTimerGlyph" Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="CompactTimerText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>

                    <!-- Weather beside the idle clock -->
                    <StackPanel x:Name="CompactWeather" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <views:WeatherSprite x:Name="CompactWeatherIcon" PixelSize="1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="CompactWeatherText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>

                    <!-- Yata nods along when you're away but the music plays on -->
                    <views:RavenSprite x:Name="MusicRaven" Grid.Column="2" PixelSize="1" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>

                    <!-- Pixel-art equalizer, like Yata: square bars stepping in whole pixel rows, built in code -->
                    <StackPanel x:Name="Equalizer" Grid.Column="2" Orientation="Horizontal" Height="14"
                                VerticalAlignment="Center" Visibility="Collapsed"
                                SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased"/>
                </Grid>

                <!-- Camera (green) / microphone (orange) in use; the expanded header names the apps -->
                <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="14,13,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Ellipse x:Name="CameraDot" Width="6" Height="6" Fill="{DynamicResource CameraBrush}"/>
                    <Ellipse x:Name="MicrophoneDot" Width="6" Height="6" Fill="{DynamicResource MicrophoneBrush}"/>
                </StackPanel>

                <!-- Ambient: Yata perched on the notch while the PC sits idle -->
                <Grid x:Name="AmbientView" Opacity="0" Visibility="Collapsed">
                    <views:RavenSprite x:Name="AmbientRaven" PixelSize="1.5" HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <views:RavenSprite.RenderTransform>
                            <TranslateTransform x:Name="AmbientRavenShift"/>
                        </views:RavenSprite.RenderTransform>
                    </views:RavenSprite>
                    <TextBlock x:Name="Zzz" Text="z" FontSize="10" FontWeight="SemiBold" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="36,3,0,0"
                               Foreground="{DynamicResource TextSecondary}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="ZzzShift"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <!-- News: what happened while you were away, brought by Yata -->
                <Grid x:Name="NewsView" Margin="20,12,20,12" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <views:RavenSprite x:Name="NewsRaven" PixelSize="2" VerticalAlignment="Top" Margin="0,2,16,0">
                        <views:RavenSprite.RenderTransform>
                            <TranslateTransform x:Name="NewsRavenShift"/>
                        </views:RavenSprite.RenderTransform>
                    </views:RavenSprite>
                    <StackPanel x:Name="NewsBody" Grid.Column="1">
                        <TextBlock x:Name="NewsTitle" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
                        <ItemsControl x:Name="NewsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <views:IconView Glyph="{Binding Glyph}" Size="12" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding At, StringFormat=HH:mm}" FontSize="11"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- HUD: transient system status (volume, brightness, battery, Caps Lock, ...) -->
                <StackPanel x:Name="HudView" Orientation="Horizontal" HorizontalAlignment="Center"
                            Opacity="0" Visibility="Collapsed">
                    <views:IconView x:Name="HudIcon" Size="15" VerticalAlignment="Center"/>
                    <!-- Takes the icon's place for small wins -->
                    <views:RavenSprite x:Name="HudRaven" PixelSize="1.5" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="HudText" Margin="10,0,0,0" MaxWidth="320" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Grid x:Name="HudBar" Width="96" Height="4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                        <Border x:Name="HudBarFill" CornerRadius="2" Background="{DynamicResource TextPrimary}" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="HudValue" Margin="10,0,0,0" FontSize="12" MinWidth="22" TextAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                               Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <!-- Expanded: sized to the expanded target so it is revealed by the clip while the notch grows -->
                <Grid x:Name="ExpandedView" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header: date + page tabs -->
                    <Grid Margin="24,10,16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock x:Name="HeaderDate" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <!-- Takes the date's place while the camera or microphone is in use -->
                            <TextBlock x:Name="PrivacyText" FontSize="12" VerticalAlignment="Center" MaxWidth="260"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <!-- Agenda and Tasks: read Google now (MainWindow.Refresh.cs); spins while it does -->
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12"
                                    Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary}" Content="&#xE72C;"
                                    ToolTip="{x:Static y:Strings.Settings_SyncNow}"
                                    AutomationProperties.Name="{x:Static y:Strings.Settings_SyncNow}"
                                    RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Click="OnRefreshClick">
                                <Button.RenderTransform>
                                    <RotateTransform x:Name="RefreshSpin"/>
                                </Button.RenderTransform>
                            </Button>
                        </StackPanel>
                        <Grid x:Name="TabStrip" HorizontalAlignment="Right">
                        <!-- Selection pill that glides to the chosen tab -->
                        <Border x:Name="TabIndicator" Width="32" Height="26" Margin="2,0,0,0" CornerRadius="8" Background="{DynamicResource SelectedFill}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TabIndicatorShift"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabMedia" Style="{StaticResource TabButton}" GroupName="Pages"
                                         Content="&#xE8D6;" ToolTip="{x:Static y:Strings.Tab_Media}" IsChecked="True" Checked="OnTabChecked"/>
                            <RadioButton x:Name="TabAgenda" Style="{StaticResource TabButton}" GroupName="Pages"
                                         Content="&#xE787;" ToolTip="{x:Static y:Strings.Tab_Agenda}" Checked="OnTabChecked"/>
                            <RadioButton x:Name="TabFocus" Style="{StaticResource TabButton}" GroupName="Pages"
                                         Content="&#xE916;" ToolTip="{x:Static y:Strings.Tab_Focus}" Checked="OnTabChecked"/>
                            <RadioButton x:Name="TabWater" Style="{StaticResource TabButton}" GroupName="Pages"
                                         Content="&#xEB42;" ToolTip="{x:Static y:Strings.Tab_Water}" Checked="OnTabChecked"/>
                            <RadioButton x:Name="TabTasks" Style="{StaticResource TabButton}" GroupName="Pages"
                                         Content="&#xE9D5;" ToolTip="{x:Static y:Strings.Tab_Tasks}" Checked="OnTabChecked"/>
                            <RadioButton x:Name="TabShelf" Style="{StaticResource TabButton}" GroupName="Pages"
                                         Content="&#xE7B8;" ToolTip="{x:Static y:Strings.Tab_Shelf}" Checked="OnTabChecked"/>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="13" Margin="6,0,0,0"
                                    Foreground="{DynamicResource TextSecondary}" Content="&#xE713;" ToolTip="{x:Static y:Strings.Tab_Settings}"
                                    Click="OnSettingsClick"/>
                        </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Player, then divider and lyrics under it: those only show while the song has lyrics -->
                    <Grid x:Name="MediaPage" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="MediaPanel" Height="136" Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="108" Height="108" VerticalAlignment="Center">
                            <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="32"
                                           Foreground="{DynamicResource TextPlaceholder}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush x:Name="ExpandedArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1" Margin="16,10,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <views:MarqueeText x:Name="TitleMarquee" HorizontalAlignment="Left">
                                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </views:MarqueeText>
                            <TextBlock x:Name="ArtistText" Grid.Row="1" Margin="0,1,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>

                            <Grid x:Name="ProgressRow" Grid.Row="3" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ElapsedText" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Typography.NumeralAlignment="Tabular"/>

                                <Grid x:Name="ProgressTrack" Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="OnTrackMouseDown" MouseMove="OnTrackMouseMove"
                                      MouseLeftButtonUp="OnTrackMouseUp" LostMouseCapture="OnTrackLostCapture"
                                      SizeChanged="OnTrackSizeChanged">
                                    <!-- Thickens and shows a handle under the mouse or while dragging -->
                                    <Border Style="{StaticResource ProgressBarPart}" Background="{DynamicResource TrackBrush}"/>
                                    <Border x:Name="ProgressFill" Style="{StaticResource ProgressBarPart}" Width="0"
                                            HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
                                    <Ellipse x:Name="ProgressThumb" Width="12" Height="12" Fill="{DynamicResource TextPrimary}"
                                             HorizontalAlignment="Left" IsHitTestVisible="False">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=ProgressTrack}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseCaptured, ElementName=ProgressTrack}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>

                                <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                           TextAlignment="Right" Foreground="{DynamicResource TextSecondary}"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Grid>

                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <!-- Filled glyphs, same family as the focus timer's buttons -->
                                <Button Style="{StaticResource IconButton}" Content="&#xF8AC;" ToolTip="{x:Static y:Strings.Media_Previous}" Click="OnPrevious"/>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryIconButton}"
                                        Width="38" Height="38" FontSize="15" Margin="12,0"
                                        Content="&#xF5B0;" Click="OnPlayPause"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xF8AD;" ToolTip="{x:Static y:Strings.Media_Next}" Click="OnNext"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Lyrics: under the player, current line kept centered -->
                    <Border x:Name="LyricsDivider" Grid.Row="1" Height="1" Margin="24,4,24,0"
                            Background="{DynamicResource DividerBrush}" Visibility="Collapsed"/>
                    <Grid x:Name="LyricsPanel" Grid.Row="2" Margin="24,8,24,16" ClipToBounds="True" Visibility="Collapsed"
                          SizeChanged="OnLyricsLayoutChanged">
                        <!-- Absolute, sized to the panel in code: relative to its bounding box, the mask would
                             stretch over the whole song and leave the lines near its start and end faint -->
                        <Grid.OpacityMask>
                            <LinearGradientBrush x:Name="LyricsFade" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.28"/>
                                <GradientStop Color="Black" Offset="0.72"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.OpacityMask>
                        <!-- Canvas so the line stack isn't layout-clipped to the panel height -->
                        <Canvas>
                            <StackPanel x:Name="LyricsLines" Width="{Binding ActualWidth, ElementName=LyricsPanel}"
                                        SizeChanged="OnLyricsLayoutChanged">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="LyricsScroll"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Grid>

                    <StackPanel x:Name="IdlePanel" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,0,0,16">
                        <!-- Yata keeps the clock company while nothing plays -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="IdleClock" FontFamily="{StaticResource DisplayFont}" FontSize="36"
                                       FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                            <views:RavenSprite x:Name="IdleRaven" PixelSize="2" VerticalAlignment="Bottom" Margin="10,0,0,10"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static y:Strings.Media_NothingPlaying}" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <StackPanel x:Name="IdleWeather" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,8,0,0" Visibility="Collapsed">
                            <views:WeatherSprite x:Name="IdleWeatherIcon" PixelSize="1.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="IdleWeatherText" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    </Grid>

                    <views:AgendaPage x:Name="AgendaPage" Grid.Row="1" Visibility="Collapsed"/>
                    <views:FocusPage x:Name="FocusPage" Grid.Row="1" Visibility="Collapsed"/>
                    <views:WaterPage x:Name="WaterPage" Grid.Row="1" Visibility="Collapsed"/>
                    <views:ShelfPage x:Name="ShelfPage" Grid.Row="1" Visibility="Collapsed"/>
                    <views:TasksPage x:Name="TasksPage" Grid.Row="1" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
