<UserControl x:Class="Yata.Views.WaterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:y="clr-namespace:Yata">
    <Grid Margin="24,0,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock>
                <Run x:Name="TodayRun" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                <Run x:Name="GoalRun" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
            </TextBlock>
            <Grid x:Name="Bar" Height="6" Margin="0,6,0,0">
                <Border CornerRadius="3" Background="{DynamicResource TrackBrush}"/>
                <Border x:Name="BarFill" CornerRadius="3" HorizontalAlignment="Left" Width="0" Background="{DynamicResource WaterBrush}"/>
            </Grid>
            <!-- Last 7 days -->
            <Grid x:Name="Chart" Height="46" Margin="-3,10,-3,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Width="58" Height="58" FontSize="24"
                    Foreground="{DynamicResource WaterBrush}" Background="{DynamicResource WaterSubtleFill}" Content="&#xEB42;" ToolTip="{x:Static y:Strings.Water_AddCup}" Click="OnDrink"/>
            <TextBlock x:Name="CupText" Margin="0,4,0,0" FontSize="12" HorizontalAlignment="Center"/>
            <Button Style="{StaticResource PillButton}" Content="{x:Static y:Strings.Water_Undo}" Height="24" FontSize="11" Margin="0,8,0,0"
                    Click="OnUndo"/>
        </StackPanel>
    </Grid>
</UserControl>
