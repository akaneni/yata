<UserControl x:Class="Yata.Views.ShelfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:y="clr-namespace:Yata"
             xmlns:local="clr-namespace:Yata.Views">
    <Grid Margin="16,0,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Empty state doubles as the drop hint -->
        <Grid x:Name="EmptyState">
            <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource OutlineBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Yata eyeing the empty box -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <local:RavenSprite PixelSize="2" VerticalAlignment="Bottom" Margin="0,0,8,0" Opacity="0.7"/>
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <TextBlock Margin="0,6,0,0" Text="{x:Static y:Strings.Shelf_DropHere}" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False" local:ScrollFade.IsEnabled="True">
            <ItemsControl x:Name="List" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Tile" Width="78" Height="82" Margin="0,0,2,2" Background="#00FFFFFF" Cursor="Hand"
                              ToolTip="{Binding FilePath}"
                              MouseLeftButtonDown="OnTileMouseDown" MouseMove="OnTileMouseMove">
                            <Border x:Name="Hover" CornerRadius="12" Background="{DynamicResource SubtleFill}" Visibility="Hidden"/>
                            <StackPanel Margin="4,8,4,4">
                                <Grid Width="44" Height="40">
                                    <!-- Shell icons at their native size stay crisp -->
                                    <Image x:Name="IconImage" Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"/>
                                    <!-- Pictures: square, cropped thumbnail -->
                                    <Border x:Name="Thumbnail" CornerRadius="8" Visibility="Collapsed">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock Margin="0,5,0,0" Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28"/>
                            </StackPanel>
                            <Button x:Name="RemoveButton" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="8"
                                    Background="{DynamicResource OverlayButtonFill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                    Content="&#xE711;" ToolTip="{x:Static y:Strings.Shelf_Remove}" Visibility="Hidden" Click="OnRemove"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPicture}" Value="True">
                                <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Thumbnail" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <local:UndoToast x:Name="Undo"/>

        <!-- Shown while files are dragged over the notch -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource NotchBrush}">
            <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource OutlineStrongBrush}" StrokeThickness="2"
                       StrokeDashArray="4 3" Fill="{DynamicResource DropFill}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           HorizontalAlignment="Center"/>
                <TextBlock Margin="0,6,0,0" Text="{x:Static y:Strings.Shelf_DropToKeep}" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="Footer" Grid.Row="1" Margin="2,6,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CountText" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>
            <Button Style="{StaticResource PillButton}" Content="{x:Static y:Strings.Shelf_Clear}" Height="24" FontSize="11"
                    HorizontalAlignment="Right" Click="OnClear"/>
        </Grid>
    </Grid>
</UserControl>
