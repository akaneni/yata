<UserControl x:Class="Yata.Views.AgendaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:y="clr-namespace:Yata"
             xmlns:local="clr-namespace:Yata.Views">
    <Grid Margin="16,0,16,14">

        <!-- Not connected, connecting, nothing today: Yata with one line and at most one action -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <local:RavenSprite x:Name="EmptyRaven" PixelSize="2" HorizontalAlignment="Center" Opacity="0.7"/>
            <TextBlock x:Name="EmptyText" Margin="0,4,0,0" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="340" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
            <Button x:Name="EmptyButton" Style="{StaticResource PrimaryPillButton}" Margin="0,10,0,0"
                    HorizontalAlignment="Center" Click="OnEmptyButton"/>
        </StackPanel>

        <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <ItemsControl x:Name="List" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Day divider ("Amanhã") -->
                            <TextBlock x:Name="Header" Text="{Binding Title}" FontSize="11" Margin="8,8,0,2"
                                       Foreground="{StaticResource TextSecondary}" Visibility="Collapsed"/>

                            <Grid x:Name="Row" Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NowBg" Grid.ColumnSpan="3" CornerRadius="10" Background="#14FFFFFF"
                                        Visibility="Collapsed"/>
                                <TextBlock x:Name="Time" Text="{Binding Time}" Margin="8,0,0,0" FontSize="12"
                                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="Join" Grid.Column="2" Style="{StaticResource PillButton}" Height="26"
                                        Margin="0,0,6,0" Visibility="Collapsed" ToolTip="{Binding MeetingUrl}" Click="OnJoin">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Static y:Strings.Agenda_Join}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter TargetName="Header" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Row" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasMeeting}" Value="True">
                                <Setter TargetName="Join" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNow}" Value="True">
                                <Setter TargetName="NowBg" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Time" Property="Foreground" Value="White"/>
                                <!-- The call that's on now is the one obvious action -->
                                <Setter TargetName="Join" Property="Style" Value="{StaticResource PrimaryPillButton}"/>
                                <Setter TargetName="Join" Property="Height" Value="26"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                <Setter TargetName="Row" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Join" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
