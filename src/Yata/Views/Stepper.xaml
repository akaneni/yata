<UserControl x:Class="Yata.Views.Stepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center">
    <Border CornerRadius="8" Background="#14FFFFFF" Height="30">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="Minus" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}"
                    Width="30" Height="30" FontSize="15" Content="−" Click="OnMinus"/>
            <TextBlock x:Name="ValueText" MinWidth="72" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"/>
            <Button x:Name="Plus" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}"
                    Width="30" Height="30" FontSize="15" Content="+" Click="OnPlus"/>
        </StackPanel>
    </Border>
</UserControl>
