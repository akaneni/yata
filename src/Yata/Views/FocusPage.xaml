<UserControl x:Class="Yata.Views.FocusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:y="clr-namespace:Yata"
             xmlns:local="clr-namespace:Yata.Views">
    <UserControl.Resources>
        <!-- Text that opens something: no pill, a faint highlight under the mouse -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="#00FFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageInset}">
        <!-- Ring | session and its task | today and the week -->
        <Grid x:Name="Main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Width="112" Height="112" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="6"/>
                <Path x:Name="ProgressArc" Stroke="{DynamicResource TextPrimary}" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="TimeText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            </Grid>

            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="PhaseText" FontSize="16" FontWeight="SemiBold"/>
                <!-- Session and when the break comes; a meeting close by takes its place -->
                <TextBlock x:Name="StatusText" Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
                <!-- One dot per session in the cycle, built in code -->
                <StackPanel x:Name="Dots" Orientation="Horizontal" Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- Iniciar / Pausar / Continuar -->
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryPillButton}" Click="OnPrimary">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PrimaryGlyph" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="PrimaryLabel" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Parar (focus) / Pular pausa (break) -->
                    <Button x:Name="SecondaryButton" Style="{StaticResource PillButton}" Height="30" Margin="8,0,0,0"
                            Click="OnSecondary">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SecondaryGlyph" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SecondaryLabel" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- The task this focus is for: tick it off here, or pick another -->
                <Grid Margin="0,8,0,0" Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TaskCheck" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="13"
                            Margin="-5,0,0,0" Content="&#xE739;" ToolTip="{x:Static y:Strings.Focus_MarkDone}"
                            Visibility="Collapsed" Click="OnTaskDone"/>
                    <Button x:Name="TaskPick" Grid.Column="1" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                            Margin="-6,0,0,0" Click="OnPickTask">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TaskGlyph" Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <!-- "Terminou?" during the break, beside the task's check -->
                            <TextBlock x:Name="TaskPrefix" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"
                                       Text="{x:Static y:Strings.Focus_Finished}"/>
                            <TextBlock x:Name="TaskText" FontSize="12" VerticalAlignment="Center" MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="6,1,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Today against the goal, and the last seven days -->
            <StackPanel Grid.Column="2" Width="112" VerticalAlignment="Center">
                <TextBlock Text="{x:Static y:Strings.Focus_Today}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="TodayText" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="GoalText" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                <local:DayBars x:Name="Week" Height="46" Margin="-3,8,-3,0" BarHeight="28"
                               TodayBrush="TextPrimary" PastBrush="FocusPastBrush"/>
            </StackPanel>
        </Grid>

        <!-- Picking the task: inside the notch, since a pop-up menu is another window and moving
             the mouse onto it would close the notch -->
        <Grid x:Name="Picker" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="{x:Static y:Strings.Focus_PickTask}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="9" HorizontalAlignment="Right"
                        Content="&#xE711;" ToolTip="{x:Static y:Strings.Focus_ClosePicker}" Click="OnClosePicker"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False" local:ScrollFade.IsEnabled="True">
                <StackPanel x:Name="PickList"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
