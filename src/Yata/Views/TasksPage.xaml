<UserControl x:Class="Yata.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yata.Views">
    <Grid Margin="16,0,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nothing to do: Yata naps -->
        <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center">
            <local:RavenSprite Frame="Sleep" PixelSize="2" HorizontalAlignment="Center" Opacity="0.7"/>
            <TextBlock Margin="0,4,0,0" Text="Nenhuma tarefa por aqui" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
            <ItemsControl x:Name="List" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="Check" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="15"
                                    Content="&#xE739;" ToolTip="Concluir" Click="OnToggle"/>
                            <TextBlock x:Name="Label" Grid.Column="1" Margin="6,0" Text="{Binding Text}" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="DueChip" Grid.Column="2" CornerRadius="8" Padding="7,1" Margin="0,0,4,0"
                                    VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding DueText}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="10"
                                    Opacity="0.6" Content="&#xE711;" ToolTip="Remover" Click="OnRemove"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Check" Property="Content" Value="&#xE73A;"/>
                                <Setter TargetName="Check" Property="ToolTip" Value="Reabrir"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasDue}" Value="True"/>
                                    <Condition Binding="{Binding Done}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="DueChip" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Height="34" Margin="0,8,0,0" CornerRadius="10" Background="{DynamicResource SubtleFill}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Placeholder" Margin="12,0" VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextPlaceholder}" Text="Nova tarefa (ex.: Reunião 15:30)"/>
                <TextBox x:Name="Input" Margin="9,0" VerticalAlignment="Center" FontSize="13"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                         SelectionBrush="{DynamicResource SelectionHighlight}" MaxLength="200"
                         PreviewMouseLeftButtonDown="OnInputMouseDown" KeyDown="OnInputKeyDown"
                         TextChanged="OnInputTextChanged" LostKeyboardFocus="OnInputLostFocus"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13"
                        Margin="0,0,2,0" Content="&#xE710;" ToolTip="Adicionar" Click="OnAdd"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
