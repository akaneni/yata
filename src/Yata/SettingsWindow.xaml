<Window x:Class="Yata.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Yata.Views"
        Title="Yata — Configurações"
        Width="580" Height="760" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/yata.ico"
        Background="#0E0E0E" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="Margin" Value="4,26,0,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="50"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,16,0"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Thin dark scrollbar instead of the light system one -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,6">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" CornerRadius="2" Background="#33FFFFFF"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#80FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <views:RavenSprite PixelSize="3" VerticalAlignment="Center"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Yata" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#8C8C8C"/>
                </StackPanel>
            </StackPanel>

            <!-- General -->
            <TextBlock Text="Geral" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Iniciar com o Windows" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Click="OnStartupClick"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Esconder em apps de tela cheia" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.HideInFullscreen}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Abrir ao passar o mouse após" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="0" Maximum="1000" Step="20" Suffix=" ms"
                                       Value="{Binding Settings.HoverDelayMs}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="Cor da capa como destaque" Style="{StaticResource Label}"/>
                            <TextBlock Text="Desligado, tudo fica em preto e branco." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.UseArtworkAccent}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Media -->
            <TextBlock Text="Mídia" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <Grid Style="{StaticResource Row}">
                    <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                        <TextBlock Text="Letras sincronizadas" Style="{StaticResource Label}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Busca no LRCLIB (lrclib.net) enviando só artista, título e duração. É o único recurso que usa a internet."/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              IsChecked="{Binding Settings.LyricsEnabled}"/>
                </Grid>
            </Border>

            <!-- Notices -->
            <TextBlock Text="Avisos no notch" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Volume" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudVolume}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Brilho" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudBrightness}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Carregador e bateria baixa" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudPower}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Troca de saída de áudio (fone, caixa)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudAudioDevice}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Caps Lock" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudCapsLock}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Idioma do teclado" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudKeyboardLayout}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Conexão de rede" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudNetwork}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Focus -->
            <TextBlock Text="Foco (Pomodoro)" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Foco" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="5" Maximum="120" Step="5" Suffix=" min"
                                       Value="{Binding Settings.FocusMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Pausa curta" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="1" Maximum="30" Step="1" Suffix=" min"
                                       Value="{Binding Settings.ShortBreakMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Pausa longa" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="5" Maximum="60" Step="5" Suffix=" min"
                                       Value="{Binding Settings.LongBreakMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Sessões até a pausa longa" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="2" Maximum="8" Step="1"
                                       Value="{Binding Settings.SessionsPerCycle}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="Pausar quando você sai" Style="{StaticResource Label}"/>
                            <TextBlock Text="Após 5 min sem uso, devolvendo o tempo não acompanhado." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.PauseFocusWhenAway}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Water -->
            <TextBlock Text="Água" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Meta diária" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="500" Maximum="5000" Step="250" Suffix=" ml"
                                       Value="{Binding Water.GoalMl}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Tamanho do copo" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="50" Maximum="1000" Step="50" Suffix=" ml"
                                       Value="{Binding Water.CupMl}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Lembretes" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Water.RemindersEnabled}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Lembrar a cada" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="15" Maximum="240" Step="15" Suffix=" min"
                                       Value="{Binding Water.ReminderMinutes}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Yata -->
            <TextBlock Text="Yata" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="Mostrar o Yata quando o PC fica parado" Style="{StaticResource Label}"/>
                            <TextBlock Text="Usa só o horário do último uso do mouse/teclado, nunca o conteúdo." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.CompanionEnabled}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Aparece após" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="1" Maximum="30" Step="1" Suffix=" min"
                                       Value="{Binding Settings.CompanionIdleMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Cochila após" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="2" Maximum="120" Step="1" Suffix=" min"
                                       Value="{Binding Settings.CompanionSleepMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Resumo ao voltar (&quot;enquanto você esteve fora&quot;)" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0,0,60,0"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.AwaySummaryEnabled}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Grid Margin="4,22,0,0">
                <TextBlock Text="Seus dados ficam só neste PC." FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center"/>
                <Button Style="{StaticResource PillButton}" Content="Abrir pasta de dados" HorizontalAlignment="Right"
                        Click="OnOpenDataFolder"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
