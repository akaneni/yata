<Window x:Class="Yata.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Yata.Views"
        xmlns:y="clr-namespace:Yata"
        Title="{x:Static y:Strings.Settings_Title}"
        Width="580" Height="760" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/yata.ico"
        Background="#0E0E0E" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="Margin" Value="4,26,0,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="50"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,16,0"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Thin dark scrollbar instead of the light system one -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,6">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" CornerRadius="2" Background="#33FFFFFF"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#80FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <views:RavenSprite PixelSize="3" VerticalAlignment="Center"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Yata" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#8C8C8C"/>
                </StackPanel>
            </StackPanel>

            <!-- General -->
            <TextBlock Text="{x:Static y:Strings.Settings_General}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,190,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_Language}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{x:Static y:Strings.Settings_LanguageHint}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <!-- Each click moves to the next language, then back to following Windows -->
                        <Button x:Name="LanguageButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnLanguageClick"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_StartWithWindows}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Click="OnStartupClick"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_Display}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <!-- Each click moves to the next connected display -->
                        <Button x:Name="MonitorButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                ToolTip="{x:Static y:Strings.Settings_DisplayTip}" Click="OnMonitorClick"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_Hotkey}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{x:Static y:Strings.Settings_HotkeyHint}"
                                       Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.HotkeyEnabled}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HideInFullscreen}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.HideInFullscreen}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HoverDelay}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="0" Maximum="1000" Step="20" Suffix=" ms"
                                       Value="{Binding Settings.HoverDelayMs}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_Accent}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{x:Static y:Strings.Settings_AccentHint}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.UseArtworkAccent}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <TextBlock Text="{x:Static y:Strings.Settings_Updates}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_UpdateCheck}" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{x:Static y:Strings.Settings_UpdateCheckHint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.UpdateCheckEnabled}"/>
                    </Grid>
                    <!-- Shown when the last check found a newer version -->
                    <Grid x:Name="UpdateRow" Style="{StaticResource Row}" Visibility="Collapsed">
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryPillButton}" Content="{x:Static y:Strings.Settings_OpenDownload}"
                                HorizontalAlignment="Right" Click="OnOpenReleases"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Media -->
            <TextBlock Text="{x:Static y:Strings.Settings_Media}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <Grid Style="{StaticResource Row}">
                    <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                        <TextBlock Text="{x:Static y:Strings.Settings_Lyrics}" Style="{StaticResource Label}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{x:Static y:Strings.Settings_LyricsHint}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              IsChecked="{Binding Settings.LyricsEnabled}"/>
                </Grid>
            </Border>

            <!-- Google: one account, a permission per feature -->
            <TextBlock Text="Google" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,170,8">
                            <TextBlock x:Name="GoogleTitle" Text="{x:Static y:Strings.Google_Account}" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="GoogleHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="GoogleButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnGoogleButton"/>
                    </Grid>

                    <StackPanel x:Name="GoogleFeatures">
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_Calendar}" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="CalendarHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="CalendarButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Content="{x:Static y:Strings.Settings_Allow}" Click="OnCalendarButton"/>
                    </Grid>

                    <StackPanel x:Name="CalendarOptions">
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <StackPanel VerticalAlignment="Center" Margin="0,8,150,8">
                                <TextBlock Text="{x:Static y:Strings.Settings_RemindBefore}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{x:Static y:Strings.Settings_RemindBeforeHint}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <views:Stepper HorizontalAlignment="Right" Minimum="0" Maximum="30" Step="1" Suffix=" min"
                                           Value="{Binding Settings.CalendarReminderMinutes}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                                <TextBlock Text="{x:Static y:Strings.Settings_NextEventCompact}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{x:Static y:Strings.Settings_NextEventCompactHint}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      IsChecked="{Binding Settings.CalendarInCompact}"/>
                        </Grid>

                        <!-- One switch per calendar in the account -->
                        <ItemsControl x:Name="CalendarList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource Divider}"/>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}"/>
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding Included, Mode=OneWay}" Click="OnCalendarToggle"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Tasks: two-way with one Google Tasks list -->
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_Tasks}" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="TasksHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="TasksButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Content="{x:Static y:Strings.Settings_Allow}" Click="OnTasksButton"/>
                        <CheckBox x:Name="TasksSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Click="OnTasksSwitch"/>
                    </Grid>
                    <StackPanel x:Name="TasksOptions">
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <StackPanel VerticalAlignment="Center" Margin="0,8,190,8">
                                <TextBlock Text="{x:Static y:Strings.Settings_TaskList}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{x:Static y:Strings.Settings_TaskListHint}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Button x:Name="TasksListButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" MaxWidth="180" Click="OnTasksList"/>
                        </Grid>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Weather -->
            <TextBlock Text="{x:Static y:Strings.Settings_Weather}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_ShowWeather}" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{x:Static y:Strings.Settings_ShowWeatherHint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.WeatherEnabled}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <StackPanel Margin="0,12,0,12">
                        <Grid>
                            <TextBlock Text="{x:Static y:Strings.Settings_City}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WeatherPlaceText" Style="{StaticResource Hint}" Margin="0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="32" CornerRadius="10" Background="#14FFFFFF">
                                <Grid>
                                    <TextBlock x:Name="WeatherSearchPlaceholder" Margin="12,0" VerticalAlignment="Center"
                                               FontSize="13" IsHitTestVisible="False" Foreground="#66FFFFFF"
                                               Text="{x:Static y:Strings.Settings_CitySearch}"/>
                                    <TextBox x:Name="WeatherSearchBox" Margin="9,0" VerticalAlignment="Center" FontSize="13"
                                             Background="Transparent" BorderThickness="0" Foreground="White"
                                             CaretBrush="White" SelectionBrush="#66FFFFFF" MaxLength="80"
                                             TextChanged="OnWeatherSearchChanged" KeyDown="OnWeatherSearchKeyDown"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="{x:Static y:Strings.Settings_Search}" Margin="8,0,0,0"
                                    Click="OnWeatherSearch"/>
                        </Grid>
                        <!-- Alternative to typing: one reading from Windows location, rounded right away -->
                        <Grid Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,190,0" VerticalAlignment="Center"
                                       Text="{x:Static y:Strings.Settings_LocateHint}"/>
                            <Button x:Name="WeatherLocateButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="OnWeatherLocate">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Static y:Strings.Settings_UseMyLocation}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="WeatherSearchStatus" Style="{StaticResource Hint}" Margin="0,0,190,0"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Button x:Name="LocationSettingsButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Content="{x:Static y:Strings.Settings_OpenWindowsSettings}" Visibility="Collapsed"
                                    Click="OnOpenLocationSettings"/>
                        </Grid>
                        <!-- Search results: click one to use it -->
                        <ItemsControl x:Name="WeatherResults" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnWeatherPlacePicked" Cursor="Hand" Focusable="False"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="8" Padding="10,7" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8C8C8C"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_RainAlerts}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{x:Static y:Strings.Settings_RainAlertsHint}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.WeatherRainAlerts}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notices -->
            <TextBlock Text="{x:Static y:Strings.Settings_Notices}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HudVolume}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudVolume}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HudBrightness}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudBrightness}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HudPower}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudPower}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HudAudioDevice}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudAudioDevice}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HudCapsLock}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudCapsLock}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HudKeyboardLayout}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudKeyboardLayout}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HudNetwork}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudNetwork}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_HudPrivacy}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudPrivacy}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Focus -->
            <TextBlock Text="{x:Static y:Strings.Settings_Focus}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_FocusLength}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="5" Maximum="120" Step="5" Suffix=" min"
                                       Value="{Binding Settings.FocusMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_ShortBreak}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="1" Maximum="30" Step="1" Suffix=" min"
                                       Value="{Binding Settings.ShortBreakMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_LongBreak}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="5" Maximum="60" Step="5" Suffix=" min"
                                       Value="{Binding Settings.LongBreakMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_SessionsPerCycle}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="2" Maximum="8" Step="1"
                                       Value="{Binding Settings.SessionsPerCycle}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_PauseWhenAway}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{x:Static y:Strings.Settings_PauseWhenAwayHint}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.PauseFocusWhenAway}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Water -->
            <TextBlock Text="{x:Static y:Strings.Settings_Water}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_WaterGoal}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="500" Maximum="5000" Step="250" Suffix=" ml"
                                       Value="{Binding Water.GoalMl}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_CupSize}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="50" Maximum="1000" Step="50" Suffix=" ml"
                                       Value="{Binding Water.CupMl}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_WaterReminders}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Water.RemindersEnabled}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_WaterEvery}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="15" Maximum="240" Step="15" Suffix=" min"
                                       Value="{Binding Water.ReminderMinutes}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Yata -->
            <TextBlock Text="Yata" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                            <TextBlock Text="{x:Static y:Strings.Settings_Companion}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{x:Static y:Strings.Settings_CompanionHint}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.CompanionEnabled}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_CompanionAfter}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="1" Maximum="30" Step="1" Suffix=" min"
                                       Value="{Binding Settings.CompanionIdleMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_CompanionSleep}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="2" Maximum="120" Step="1" Suffix=" min"
                                       Value="{Binding Settings.CompanionSleepMinutes}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{x:Static y:Strings.Settings_AwaySummary}" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0,0,60,0"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.AwaySummaryEnabled}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Grid Margin="4,22,0,0">
                <TextBlock Text="{x:Static y:Strings.Settings_DataLocal}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center"/>
                <Button Style="{StaticResource PillButton}" Content="{x:Static y:Strings.Settings_OpenDataFolder}" HorizontalAlignment="Right"
                        Click="OnOpenDataFolder"/>
            </Grid>
            <Grid Margin="4,10,0,0">
                <TextBlock Text="{x:Static y:Strings.Settings_LogLocal}" FontSize="12" Foreground="#8C8C8C"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PillButton}" Content="{x:Static y:Strings.Settings_OpenLog}" Margin="0,0,8,0"
                            Click="OnOpenLogs"/>
                    <Button x:Name="DiagnosticsButton" Style="{StaticResource PillButton}" Content="{x:Static y:Strings.Settings_CopyDiagnostics}"
                            Click="OnCopyDiagnostics"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
