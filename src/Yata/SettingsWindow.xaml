<Window x:Class="Yata.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Yata.Views"
        Title="Yata — Configurações"
        Width="580" Height="760" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/yata.ico"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Unlike the notch, this is an ordinary window: its controls take keyboard focus, so Tab
             walks the settings and Space/Enter change them. -->
        <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <Style x:Key="PrimaryPillButton" TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
            <Setter Property="Focusable" Value="True"/>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHint}"/>
            <Setter Property="Margin" Value="4,26,0,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style x:Key="Row" TargetType="views:SettingRow">
            <Setter Property="MinHeight" Value="50"/>
            <!-- Names each row's control after its label, for screen readers -->
            <EventSetter Event="Loaded" Handler="OnRowLoaded"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,16,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Thin scrollbar in the window's colors instead of the system one -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,6">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" CornerRadius="2" Background="{DynamicResource ScrollThumb}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbPressed}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        </Style>
    </Window.Resources>

    <!-- Not a tab stop itself: focusing a control scrolls it into view -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,22,28,28">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <views:RavenSprite PixelSize="3" VerticalAlignment="Center"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Yata" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextHint}"/>
                </StackPanel>
            </StackPanel>

            <!-- General -->
            <TextBlock Text="Geral" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Iniciar com o Windows" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Click="OnStartupClick"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Tela do notch" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <!-- Each click moves to the next connected display -->
                        <Button x:Name="MonitorButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                ToolTip="Clique para trocar de tela" Click="OnMonitorClick"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Abrir e fechar com Ctrl+Alt+Y" Style="{StaticResource Label}"/>
                            <TextBlock Text="O Windows avisa só essa combinação; nada mais do que você digita é lido."
                                       Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.HotkeyEnabled}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Esconder em apps de tela cheia" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.HideInFullscreen}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Abrir ao passar o mouse após" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="0" Maximum="1000" Step="20" Suffix=" ms"
                                       Value="{Binding Settings.HoverDelayMs}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Cor da capa como destaque" Style="{StaticResource Label}"/>
                            <TextBlock Text="Desligado, tudo fica em preto e branco." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.UseArtworkAccent}"/>
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <TextBlock Text="Atualizações" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Avisar quando houver versão nova" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Uma consulta por dia à página pública de versões do GitHub. Nada sobre você ou o PC é enviado, e a instalação continua manual."/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.UpdateCheckEnabled}"/>
                    </views:SettingRow>
                    <!-- Shown when the last check found a newer version -->
                    <views:SettingRow x:Name="UpdateRow" Style="{StaticResource Row}" Visibility="Collapsed">
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryPillButton}" Content="Abrir página de download"
                                HorizontalAlignment="Right" Click="OnOpenReleases"/>
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <!-- Media -->
            <TextBlock Text="Mídia" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <views:SettingRow Style="{StaticResource Row}">
                    <StackPanel VerticalAlignment="Center" Margin="0,8">
                        <TextBlock Text="Letras sincronizadas" Style="{StaticResource Label}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Busca no LRCLIB (lrclib.net) enviando só artista, título e duração."/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              IsChecked="{Binding Settings.LyricsEnabled}"/>
                </views:SettingRow>
            </Border>

            <!-- Google: one account, a permission per feature -->
            <TextBlock Text="Google" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock x:Name="GoogleTitle" Text="Conta Google" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="GoogleHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="GoogleButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnGoogleButton"/>
                    </views:SettingRow>

                    <StackPanel x:Name="GoogleFeatures">
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Agenda" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="CalendarHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="CalendarButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Content="Permitir" Click="OnCalendarButton"/>
                    </views:SettingRow>

                    <StackPanel x:Name="CalendarOptions">
                        <Border Style="{StaticResource Divider}"/>
                        <views:SettingRow Style="{StaticResource Row}">
                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="Avisar antes do evento" Style="{StaticResource Label}"/>
                                <TextBlock Text="Com 0, avisa só quando começa." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <views:Stepper HorizontalAlignment="Right" Minimum="0" Maximum="30" Step="1" Suffix=" min"
                                           Value="{Binding Settings.CalendarReminderMinutes}"/>
                        </views:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <views:SettingRow Style="{StaticResource Row}">
                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="Próximo evento no notch fechado" Style="{StaticResource Label}"/>
                                <TextBlock Text="Nos 15 minutos antes, no lugar do relógio." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      IsChecked="{Binding Settings.CalendarInCompact}"/>
                        </views:SettingRow>

                        <!-- One switch per calendar in the account -->
                        <ItemsControl x:Name="CalendarList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource Divider}"/>
                                        <views:SettingRow Style="{StaticResource Row}">
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}"/>
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding Included, Mode=OneWay}" Click="OnCalendarToggle"/>
                                        </views:SettingRow>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Tasks: two-way with one Google Tasks list -->
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Tarefas" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="TasksHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="TasksButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Content="Permitir" Click="OnTasksButton"/>
                        <CheckBox x:Name="TasksSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Click="OnTasksSwitch"/>
                    </views:SettingRow>
                    <StackPanel x:Name="TasksOptions">
                        <Border Style="{StaticResource Divider}"/>
                        <views:SettingRow Style="{StaticResource Row}">
                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="Lista" Style="{StaticResource Label}"/>
                                <TextBlock Text="Clique para trocar. A aba Tarefas mostra esta lista." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Button x:Name="TasksListButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" MaxWidth="180" Click="OnTasksList"/>
                        </views:SettingRow>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Weather -->
            <TextBlock Text="Tempo" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Mostrar o tempo" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Dados do Open-Meteo (open-meteo.com), sem conta. Envia só as coordenadas da cidade, arredondadas (~1 km)."/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.WeatherEnabled}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <StackPanel Margin="0,12,0,12">
                        <views:SettingRow>
                            <TextBlock Text="Cidade" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WeatherPlaceText" Style="{StaticResource Hint}" Margin="0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </views:SettingRow>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="32" CornerRadius="10" Background="{DynamicResource SubtleFill}">
                                <Grid>
                                    <TextBlock x:Name="WeatherSearchPlaceholder" Margin="12,0" VerticalAlignment="Center"
                                               FontSize="13" IsHitTestVisible="False" Foreground="{DynamicResource TextPlaceholder}"
                                               Text="Buscar cidade (ex.: Campinas)"/>
                                    <TextBox x:Name="WeatherSearchBox" Margin="9,0" VerticalAlignment="Center" FontSize="13"
                                             AutomationProperties.Name="Buscar cidade"
                                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                                             CaretBrush="{DynamicResource TextPrimary}" SelectionBrush="{DynamicResource SelectionHighlight}" MaxLength="80"
                                             TextChanged="OnWeatherSearchChanged" KeyDown="OnWeatherSearchKeyDown"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="Buscar" Margin="8,0,0,0"
                                    Click="OnWeatherSearch"/>
                        </Grid>
                        <!-- Alternative to typing: one reading from Windows location, rounded right away -->
                        <views:SettingRow Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"
                                       Text="Ou use a localização do Windows uma vez: a posição é arredondada para ~1 km na hora e nunca é guardada com precisão."/>
                            <Button x:Name="WeatherLocateButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" AutomationProperties.Name="Usar minha localização"
                                    Click="OnWeatherLocate">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Usar minha localização" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </views:SettingRow>
                        <views:SettingRow Margin="0,8,0,0">
                            <TextBlock x:Name="WeatherSearchStatus" Style="{StaticResource Hint}" Margin="0"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="LocationSettingsButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Content="Abrir configurações do Windows" Visibility="Collapsed"
                                    Click="OnOpenLocationSettings"/>
                        </views:SettingRow>
                        <!-- Search results: click one to use it -->
                        <ItemsControl x:Name="WeatherResults" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnWeatherPlacePicked" Cursor="Hand"
                                            FocusVisualStyle="{StaticResource FocusRing}" HorizontalContentAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Name}"
                                            AutomationProperties.HelpText="{Binding Detail}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="8" Padding="10,7" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFill}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextHint}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Avisar quando for chover" Style="{StaticResource Label}"/>
                            <TextBlock Text="Quando a chance passa de 60% nas próximas 2 horas." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.WeatherRainAlerts}"/>
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <!-- Notices -->
            <TextBlock Text="Avisos no notch" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Volume" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudVolume}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Brilho" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudBrightness}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Carregador e bateria baixa" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudPower}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Troca de saída de áudio (fone, caixa)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudAudioDevice}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Caps Lock" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudCapsLock}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Idioma do teclado" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudKeyboardLayout}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Conexão de rede" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudNetwork}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Câmera e microfone em uso" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.HudPrivacy}"/>
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <!-- Focus -->
            <TextBlock Text="Foco (Pomodoro)" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Foco" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="5" Maximum="120" Step="5" Suffix=" min"
                                       Value="{Binding Settings.FocusMinutes}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Pausa curta" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="1" Maximum="30" Step="1" Suffix=" min"
                                       Value="{Binding Settings.ShortBreakMinutes}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Pausa longa" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="5" Maximum="60" Step="5" Suffix=" min"
                                       Value="{Binding Settings.LongBreakMinutes}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Sessões até a pausa longa" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="2" Maximum="8" Step="1"
                                       Value="{Binding Settings.SessionsPerCycle}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Pausar quando você sai" Style="{StaticResource Label}"/>
                            <TextBlock Text="Após 5 min sem uso, devolvendo o tempo não acompanhado." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.PauseFocusWhenAway}"/>
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <!-- Water -->
            <TextBlock Text="Água" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Meta diária" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="500" Maximum="5000" Step="250" Suffix=" ml"
                                       Value="{Binding Water.GoalMl}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Tamanho do copo" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="50" Maximum="1000" Step="50" Suffix=" ml"
                                       Value="{Binding Water.CupMl}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Lembretes" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Water.RemindersEnabled}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Lembrar a cada" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="15" Maximum="240" Step="15" Suffix=" min"
                                       Value="{Binding Water.ReminderMinutes}"/>
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <!-- Yata -->
            <TextBlock Text="Yata" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <views:SettingRow Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="Mostrar o Yata quando o PC fica parado" Style="{StaticResource Label}"/>
                            <TextBlock Text="Usa só o horário do último uso do mouse/teclado, nunca o conteúdo." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.CompanionEnabled}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Aparece após" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="1" Maximum="30" Step="1" Suffix=" min"
                                       Value="{Binding Settings.CompanionIdleMinutes}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Cochila após" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <views:Stepper HorizontalAlignment="Right" Minimum="2" Maximum="120" Step="1" Suffix=" min"
                                       Value="{Binding Settings.CompanionSleepMinutes}"/>
                    </views:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <views:SettingRow Style="{StaticResource Row}">
                        <TextBlock Text="Resumo ao voltar (&quot;enquanto você esteve fora&quot;)" Style="{StaticResource Label}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.AwaySummaryEnabled}"/>
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <views:SettingRow Margin="4,22,0,0">
                <TextBlock Text="Seus dados ficam só neste PC." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextHint}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource PillButton}" Content="Abrir pasta de dados" HorizontalAlignment="Right"
                        Click="OnOpenDataFolder"/>
            </views:SettingRow>
            <views:SettingRow Margin="4,10,0,0">
                <TextBlock Text="Algum problema? O registro também fica só aqui." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextHint}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PillButton}" Content="Abrir registro" Margin="0,0,8,0"
                            Click="OnOpenLogs"/>
                    <Button x:Name="DiagnosticsButton" Style="{StaticResource PillButton}" Content="Copiar diagnóstico"
                            Click="OnCopyDiagnostics"/>
                </StackPanel>
            </views:SettingRow>
        </StackPanel>
    </ScrollViewer>
</Window>
