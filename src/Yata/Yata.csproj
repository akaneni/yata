<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from the pixel-art sprite by tools/make-icon.ps1 -->
    <ApplicationIcon>Assets\yata.ico</ApplicationIcon>
    <AssemblyName>Yata</AssemblyName>
    <RootNamespace>Yata</RootNamespace>
    <Version>0.1.1</Version>
    <!-- Keep ProductVersion exactly the version ("0.1.1", not "0.1.1+commit"): code signing (SignPath)
         checks it against the release tag. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- DPI awareness lives in app.manifest for WPF; the WinForms analyzer doesn't apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\yata.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yata.Tests" />
  </ItemGroup>

  <!-- Google OAuth client ("Desktop app") for the calendar. Official releases get it from the
       YATA_GOOGLE_CLIENT_ID / YATA_GOOGLE_CLIENT_SECRET environment variables (GitHub secrets); it is
       never committed. Builds without it still run, with the calendar disabled. See docs/google-calendar.md. -->
  <ItemGroup Condition="'$(YATA_GOOGLE_CLIENT_ID)' != '' And '$(YATA_GOOGLE_CLIENT_SECRET)' != ''">
    <AssemblyMetadata Include="GoogleClientId" Value="$(YATA_GOOGLE_CLIENT_ID)" />
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(YATA_GOOGLE_CLIENT_SECRET)" />
  </ItemGroup>

</Project>
