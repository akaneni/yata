<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from the pixel-art sprite by tools/make-icon.ps1 -->
    <ApplicationIcon>Assets\yata.ico</ApplicationIcon>
    <AssemblyName>Yata</AssemblyName>
    <RootNamespace>Yata</RootNamespace>
    <Version>0.5.0</Version>
    <!-- Keep ProductVersion exactly the version ("0.1.1", not "0.1.1+commit"): code signing (SignPath)
         checks it against the release tag. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- DPI awareness lives in app.manifest for WPF; the WinForms analyzer doesn't apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <!-- Lean WinRT projection: only the namespaces Yata uses, instead of the whole Windows SDK projection
       (Microsoft.Windows.SDK.NET.dll, ~25 MB). The metadata comes from NuGet, so no Windows SDK install
       is needed to build. -->
  <PropertyGroup>
    <CsWinRTIncludes>
      Windows.Foundation;
      Windows.Media.Control;Windows.Media.MediaPlaybackAutoRepeatMode;Windows.Media.MediaPlaybackType;
      Windows.Storage.Streams;
      Windows.Networking.Connectivity;Windows.Networking.HostName;Windows.Networking.IHostName;Windows.Networking.EndpointPair;Windows.Networking.IEndpointPair;Windows.Networking.DomainNameType;
      Windows.System.Power;Windows.System.SystemManagementContract;
      Windows.Devices.Geolocation
    </CsWinRTIncludes>
    <!-- Parts of those namespaces Yata doesn't use and that would drag in Windows.Storage. -->
    <CsWinRTExcludes>
      Windows.Foundation.Diagnostics;
      Windows.Storage.Streams.FileRandomAccessStream;Windows.Storage.Streams.IFileRandomAccessStreamStatics;
      Windows.Storage.Streams.FileInputStream;Windows.Storage.Streams.FileOutputStream;
      Windows.Storage.Streams.RandomAccessStreamReference;Windows.Storage.Streams.IRandomAccessStreamReferenceStatics
    </CsWinRTExcludes>
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.28000.2705" ExcludeAssets="all" GeneratePathProperty="true" />
    <CsWinRTInputs Include="$(PkgMicrosoft_Windows_SDK_Contracts)\ref\netstandard2.0\*.winmd" />
  </ItemGroup>
  <!-- Left empty, CsWinRT falls back to the installed Windows SDK; the contract .winmd files above
       already carry that metadata. -->
  <Target Name="YataWinRTMetadataFromNuGet" BeforeTargets="CsWinRTGenerateProjection">
    <PropertyGroup>
      <CsWinRTWindowsMetadata></CsWinRTWindowsMetadata>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Assets\yata.ico" />
  </ItemGroup>

  <!-- The agent skill, kept once in the Claude Code plugin; Settings → AI agents copies it where agents look. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\integrations\claude-code\skills\yata-notch\SKILL.md" LogicalName="SKILL.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yata.Tests" />
  </ItemGroup>

  <!-- Interface text: Strings.resx is English (the default), Strings.pt-BR.resx the Portuguese.
       Builds the Yata.Strings class, used as Strings.Key in code and {x:Static y:Strings.Key} in XAML. -->
  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <StronglyTypedFileName>Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Yata</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
  <!-- WPF compiles the XAML before resources by default, but x:Static needs the class first. The class
       sits next to Strings.resx (git-ignored) because XAML's temporary build only sees project files;
       ResGen adds it to Compile again, so it is put back once. -->
  <Target Name="StringsBeforeXaml" BeforeTargets="MarkupCompilePass1" DependsOnTargets="PrepareResourceNames;ResGen" />
  <Target Name="StringsCompiledOnce" AfterTargets="CoreResGen">
    <ItemGroup>
      <Compile Remove="Strings.Designer.cs" />
      <Compile Include="Strings.Designer.cs" />
    </ItemGroup>
  </Target>

  <!-- Google OAuth client ("Desktop app") for the calendar. Official releases get it from the
       YATA_GOOGLE_CLIENT_ID / YATA_GOOGLE_CLIENT_SECRET environment variables (GitHub secrets); it is
       never committed. Builds without it still run, with the calendar disabled. See docs/google-calendar.md. -->
  <ItemGroup Condition="'$(YATA_GOOGLE_CLIENT_ID)' != '' And '$(YATA_GOOGLE_CLIENT_SECRET)' != ''">
    <AssemblyMetadata Include="GoogleClientId" Value="$(YATA_GOOGLE_CLIENT_ID)" />
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(YATA_GOOGLE_CLIENT_SECRET)" />
  </ItemGroup>

</Project>
