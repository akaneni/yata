<UserControl x:Class="Notch.Views.FocusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,22,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Width="112" Height="112" VerticalAlignment="Center">
            <Ellipse Stroke="{StaticResource TrackBrush}" StrokeThickness="6"/>
            <Path x:Name="ProgressArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <TextBlock x:Name="TimeText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        </Grid>

        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="PhaseText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="HintText" Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <StackPanel x:Name="Dots" Orientation="Horizontal" Margin="0,8,0,0">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0"/>
                <Ellipse Width="8" Height="8" Margin="0,0,6,0"/>
                <Ellipse Width="8" Height="8" Margin="0,0,6,0"/>
                <Ellipse Width="8" Height="8" Margin="0,0,6,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="-8,8,0,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reiniciar" Click="OnReset"/>
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Width="42" Height="42" FontSize="20"
                        Margin="6,0" Content="&#xE768;" Click="OnToggle"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Pular fase" Click="OnSkip"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
